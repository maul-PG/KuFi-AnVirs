<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Background utama aplikasi (Deep Dark Blue) -->
    <SolidColorBrush x:Key="BgDeepDarkBlue" Color="#0F172A" />
    
    <!-- Warna accent utama (Mint) -->
    <SolidColorBrush x:Key="EthericMint" Color="#99F6E4" />
    
    <!-- Tambahan warna untuk konsistensi -->
    <SolidColorBrush x:Key="CardBackground" Color="#1E293B" />
    <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC" />
    <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8" />
    
</ResourceDictionary>
