<Page x:Class="KuFi.UI.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="DashboardPage"
      Background="{DynamicResource BgDeepDarkBlue}"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded"
      AllowDrop="True"
      Drop="Page_Drop">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Animasi Pulse Halus untuk Lingkaran Tengah -->
            <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="PulseCircle1" Storyboard.TargetProperty="Opacity" From="0.6" To="0" Duration="0:0:2.5" />
                <DoubleAnimation Storyboard.TargetName="PulseCircle1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.6" Duration="0:0:2.5" />
                <DoubleAnimation Storyboard.TargetName="PulseCircle1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.6" Duration="0:0:2.5" />
                
                <DoubleAnimation Storyboard.TargetName="PulseCircle2" Storyboard.TargetProperty="Opacity" From="0.4" To="0" Duration="0:0:2.5" BeginTime="0:0:1.2" />
                <DoubleAnimation Storyboard.TargetName="PulseCircle2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.8" Duration="0:0:2.5" BeginTime="0:0:1.2" />
                <DoubleAnimation Storyboard.TargetName="PulseCircle2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.8" Duration="0:0:2.5" BeginTime="0:0:1.2" />
            </Storyboard>
        </ResourceDictionary>
    </Page.Resources>

    <Page.Triggers>
        <EventTrigger RoutedEvent="Page.Loaded">
            <BeginStoryboard Storyboard="{StaticResource PulseStoryboard}" />
        </EventTrigger>
    </Page.Triggers>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- Sidebar dihapus dari sini karena sudah dipindahkan ke MainWindow.xaml -->
        <Grid Margin="60,30,60,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,10">
            <TextBlock x:Name="TxtWelcome" Foreground="{DynamicResource TextPrimary}" FontSize="40" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <Border Background="#1E293B" CornerRadius="12" Padding="15,6" Margin="0,15,0,0" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M 0 0 L 4 0 L 4 10 L 12 0 L 17 0 L 7 12 L 17 24 L 12 24 L 4 14 L 4 24 L 0 24 Z" Fill="{DynamicResource EthericMint}" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtSystemStatus" Text="KuFi AnVirs • SYSTEM SECURED" Foreground="{DynamicResource EthericMint}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Status & Statistik Real-Time -->
        <Grid Grid.Row="1" HorizontalAlignment="Center" Margin="0,10,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="16"/>
                <TextBlock Text="System CPU: " Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="13"/>
                <TextBlock x:Name="TxtCpu" Text="--%" Foreground="{DynamicResource EthericMint}" FontWeight="Bold" VerticalAlignment="Center" FontSize="14"/>
            </StackPanel>
            
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock Text="&#xE9A6;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="16"/>
                <TextBlock Text="Available RAM: " Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="13"/>
                <TextBlock x:Name="TxtRam" Text="-- GB" Foreground="{DynamicResource EthericMint}" FontWeight="Bold" VerticalAlignment="Center" FontSize="14"/>
            </StackPanel>
        </Grid>

        <!-- Lingkaran 'SCAN NOW' di Tengah -->
        <Grid Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,60" Panel.ZIndex="10">
            
            <!-- Layer Efek Pulse -->
            <Ellipse x:Name="PulseCircle2" Width="200" Height="200" Stroke="{DynamicResource EthericMint}" StrokeThickness="1" Opacity="0.2" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="PulseCircle1" Width="200" Height="200" Stroke="{DynamicResource EthericMint}" StrokeThickness="2" Opacity="0.4" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- Latar Utama Tombol -->
            <Ellipse Width="200" Height="200" Fill="#0B1120" Stroke="{DynamicResource EthericMint}" StrokeThickness="1" />
            
            <!-- Tombol Interaktif -->
            <Button Width="200" Height="200" Background="Transparent" BorderThickness="0" Click="ScanNow_Click" Cursor="Hand">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="50" Foreground="{DynamicResource EthericMint}" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <TextBlock x:Name="TxtScanStatus" Text="S C A N   N O W" Foreground="{DynamicResource EthericMint}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                </StackPanel>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            
            <!-- Progress Bar Kecil di bawah lingkaran -->
            <ProgressBar x:Name="QuickScanProgress" VerticalAlignment="Bottom" Margin="0,0,0,-40" Height="4" Width="100" Foreground="{DynamicResource EthericMint}" Background="#2A374A" BorderThickness="0" Visibility="Hidden" IsIndeterminate="True" />
            <TextBlock x:Name="TxtQuickScanDetail" Text="" Foreground="{DynamicResource TextSecondary}" FontSize="12" FontFamily="Segoe UI" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-65" Visibility="Hidden" />
        </Grid>

        <!-- Kartu Fitur Navigasi di Bawah -->
        <Grid Grid.Row="3" Margin="0,15,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="25"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Kartu Flashdrive Rescue -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="12" Padding="30" BorderBrush="#2A374A" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="4" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel>
                    <Grid>
                        <Border Background="#1A99F6E4" Width="42" Height="42" CornerRadius="8" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE8D5;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource EthericMint}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                        </Border>
                        <Border Background="#2A374A" CornerRadius="6" Padding="12,6" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="UTILITY" Foreground="{DynamicResource TextSecondary}" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="Flashdrive Rescue" Foreground="{DynamicResource TextPrimary}" FontSize="22" FontFamily="Segoe UI" FontWeight="Bold" Margin="0,25,0,10"/>
                    <TextBlock Text="Instantly sanitize and recover files from external drives potentially exposed in public terminals." Foreground="{DynamicResource TextSecondary}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,30" LineHeight="20"/>
                    
                    <Button Click="LaunchRescue_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Launch Tool" Foreground="{DynamicResource EthericMint}" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource EthericMint}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>            <!-- Kartu App Sandbox -->
            <Border Grid.Column="2" Background="#1E293B" CornerRadius="12" Padding="30" BorderBrush="#2A374A" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="4" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel>
                    <Grid>
                        <Border Background="#1A99F6E4" Width="42" Height="42" CornerRadius="8" HorizontalAlignment="Left">
                            <TextBlock Text="&#xEA35;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource EthericMint}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                        </Border>
                        <Border Background="#133D36" CornerRadius="6" Padding="12,6" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="RECOMMENDED" Foreground="{DynamicResource EthericMint}" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="App Sandbox" Foreground="{DynamicResource TextPrimary}" FontSize="22" FontFamily="Segoe UI" FontWeight="Bold" Margin="0,25,0,10"/>
                    <TextBlock Text="Open suspicious academic software or project files in a completely isolated environment." Foreground="{DynamicResource TextSecondary}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,30" LineHeight="20"/>
                    
                    <Button Click="LaunchSandbox_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Launch Sandbox" Foreground="{DynamicResource EthericMint}" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource EthericMint}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
    </ScrollViewer>
</Page>
