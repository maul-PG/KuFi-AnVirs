<Page x:Class="KuFi.UI.Views.RescuePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="RescuePage"
      Background="{DynamicResource BgDeepDarkBlue}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <!-- Margin kiri dikurangi karena Sidebar sudah disuplai dari MainWindow -->
    <Grid Margin="60,30,60,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Utama -->
        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="TOOLS   >   " Foreground="{DynamicResource TextSecondary}" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock Text="RESCUE" Foreground="{DynamicResource EthericMint}" FontSize="12" FontWeight="Bold"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Flashdrive Rescue - Manual Scan" Foreground="{DynamicResource TextPrimary}" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Text="Protection Status: Engine Active" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Bottom" Margin="40,0,0,5" FontStyle="Italic"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Panel Kiri: Daftar Drive Otomatis -->
            <StackPanel Grid.Column="0">
                <Border Background="{DynamicResource CardBackground}" CornerRadius="16" Padding="25">
                    <StackPanel>
                        <!-- Title Daftar Drive -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                            <TextBlock Text="&#xE8D5;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource EthericMint}" FontSize="18" Margin="0,0,15,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Available Drives" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ListBox x:Name="DrivesList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,25" Height="200" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- Menghapus Border dari DataTemplate agar Hover Style dari ListBoxItem bekerja presisi pada Container utama -->
                                    <Grid Margin="20,15" Width="310">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Ikon Lingkaran USB -->
                                        <Border Grid.Column="0" Background="#1E293B" Width="40" Height="40" CornerRadius="20" Margin="0,0,15,0">
                                            <TextBlock Text="&#xE88E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EthericMint}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        
                                        <!-- Data Dinamis Partisi -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5"/>
                                            <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <!-- Kustomisasi seleksi hover ListBox agar presisi sesuai kursor -->
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,10"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Background" Value="#2A374A"/>
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <!-- Container Border Utama dipindah ke sini -->
                                                <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2" CornerRadius="12">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#324259"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#132A33"/>
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource EthericMint}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <!-- Tombol Pemicu Pembersihan & Penghenti -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Button x:Name="BtnRescue" Grid.Column="0" Click="BtnRescue_Click" Background="{DynamicResource EthericMint}" Foreground="#0F172A" FontWeight="Bold" FontSize="14" Height="45" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0"/>
                                                <TextBlock Text="Rescue Drive" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="BtnStop" Grid.Column="2" Click="BtnStop_Click" Background="#EF4444" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" Height="45" BorderThickness="0" Cursor="Hand" IsEnabled="False" Opacity="0.5">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0"/>
                                                <TextBlock Text="Stop Scan" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Box Deskripsi Operasi -->
                <StackPanel Orientation="Horizontal" Margin="0,25,0,0">
                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource EthericMint}" FontSize="16" Margin="0,0,15,0"/>
                    <TextBlock Text="KuFi DeepScan engine will attempt to reconstruct the Master File Table and recover orphaned bits from the flash storage layer." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12" Width="360" LineHeight="18"/>
                </StackPanel>
            </StackPanel>

            <!-- Panel Kanan: Animasi Progress & Real-Time Log -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Animasi Lingkaran & Status -->
                <Border Grid.Row="0" Background="{DynamicResource CardBackground}" CornerRadius="16" Padding="30" Margin="0,0,0,20">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Progress Ring Pseudo-Animasi -->
                        <Grid Width="180" Height="180" Margin="0,0,0,25">
                            <Ellipse Stroke="#2A374A" StrokeThickness="12"/>
                            <Ellipse x:Name="ProgressRing" Stroke="{DynamicResource EthericMint}" StrokeThickness="12" StrokeDashArray="3.14 3.14" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtProgressPercent" Text="0%" FontSize="40" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtProcessing" Text="WAITING" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        
                        <TextBlock x:Name="TxtStatus" Text="Ready to scan" Foreground="{DynamicResource TextPrimary}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtTime" Text="Time elapsed: 00:00:00 • Remaining: --:--:--" Foreground="{DynamicResource TextSecondary}" FontSize="13" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Modul 'Rescue Real-Time Log' -->
                <Border Grid.Row="1" Background="{DynamicResource CardBackground}" CornerRadius="16" Padding="25">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="RESCUE REAL-TIME LOG" Foreground="{DynamicResource EthericMint}" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Text=" • •" Foreground="{DynamicResource EthericMint}" FontWeight="Bold" FontSize="12" Margin="5,0,0,0"/>
                        </StackPanel>
                        
                        <!-- Panel Hitam tempat Log ditampilkan -->
                        <Border Grid.Row="1" Background="#0F172A" CornerRadius="8" Padding="15">
                            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                                <!-- Tulisan Hijau khas Terminal/Console -->
                                <TextBlock x:Name="TxtLog" Foreground="{DynamicResource EthericMint}" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" LineHeight="22"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
                
                <!-- Detail Statistik Restorasi (Static Placeholder) -->
                <Grid Grid.Row="2" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="15">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#2A374A" Width="35" Height="35" CornerRadius="17.5" Margin="0,0,12,0">
                                <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource EthericMint}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="RECOVERED" Foreground="{DynamicResource TextSecondary}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtRecoveredSize" Text="0 MB" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <Border Grid.Column="2" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="15">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#2A374A" Width="35" Height="35" CornerRadius="17.5" Margin="0,0,12,0">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource EthericMint}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="TOTAL FILES" Foreground="{DynamicResource TextSecondary}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtTotalFiles" Text="0" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <Border Grid.Column="4" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="15">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#2A374A" Width="35" Height="35" CornerRadius="17.5" Margin="0,0,12,0">
                                <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource EthericMint}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="HEALTH" Foreground="{DynamicResource TextSecondary}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="Stable" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Page>
