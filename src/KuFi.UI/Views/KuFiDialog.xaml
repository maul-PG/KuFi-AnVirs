<Window x:Class="KuFi.UI.Views.KuFiDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dialog" Height="Auto" Width="450"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" SizeToContent="Height" Topmost="True">

    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#99F6E4"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderBrush" Value="#2A374A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BgBorder" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#1A99F6E4"/>
                                <Setter TargetName="BgBorder" Property="BorderBrush" Value="#99F6E4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1E293B" CornerRadius="12" BorderBrush="#2A374A" BorderThickness="1" Margin="15">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Grid Grid.Row="0" Background="#0F172A">
                <Grid.Clip>
                    <RectangleGeometry Rect="0,0,420,40" RadiusX="12" RadiusY="12"/>
                </Grid.Clip>
                <TextBlock x:Name="TxtTitle" Text="Title" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="15,10"/>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Width="30" Height="30" Background="Transparent" BorderThickness="0" Foreground="White" Cursor="Hand" Click="Close_Click">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="15">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#44EF4444"/>
                                    <Setter Property="Foreground" Value="#EF4444"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
            <Rectangle Grid.Row="0" Height="1" Fill="#2A374A" VerticalAlignment="Bottom"/>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="IconText" Grid.Column="0" FontFamily="Segoe MDL2 Assets" FontSize="36" Margin="0,0,20,0" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#3B82F6" Text="&#xE946;"/>
                <TextBlock x:Name="TxtMessage" Grid.Column="1" Text="Message goes here..." Foreground="#CBD5E1" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </Grid>

            <!-- Buttons -->
            <StackPanel x:Name="ButtonPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,20">
                <Button x:Name="BtnNo" Content="No" Visibility="Collapsed" Click="BtnNo_Click" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0"/>
                <Button x:Name="BtnYes" Content="Yes" Visibility="Collapsed" Click="BtnYes_Click" Style="{StaticResource ActionButtonStyle}"/>
                <Button x:Name="BtnOk" Content="OK" Visibility="Visible" Click="BtnOk_Click" Style="{StaticResource ActionButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
