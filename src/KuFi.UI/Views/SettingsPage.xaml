<Page x:Class="KuFi.UI.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="SettingsPage"
      Background="{DynamicResource BgDeepDarkBlue}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Kustomisasi CheckBox menjadi Toggle Switch bergaya Mint -->
            <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                
                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                
                                <!-- Track (Latar Belakang Toggle) -->
                                <Border x:Name="Track" Grid.Column="1" Height="24" CornerRadius="12" Background="#2A374A" VerticalAlignment="Center">
                                    <!-- Thumb (Lingkaran dalam Toggle) -->
                                    <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="#64748B" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- Efek Aktif saat IsChecked=True -->
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="#133D36"/>
                                    <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource EthericMint}"/>
                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="60,30,60,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,40">
            <TextBlock Text="Settings" Foreground="{DynamicResource TextPrimary}" FontSize="32" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Container Pengaturan yang bisa di-scroll -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel MaxWidth="700" HorizontalAlignment="Left">
                    <TextBlock Text="GENERAL PREFERENCES" Foreground="{DynamicResource TextSecondary}" FontSize="12" FontWeight="Bold" Margin="0,0,0,15"/>
                    
                    <!-- Opsi 1: Run as Admin -->
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="16" Padding="25" Margin="0,0,0,15">
                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="True">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource EthericMint}" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="18"/>
                                    <TextBlock Text="Run as Administrator on Startup" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="Require UAC elevated privileges when starting to ensure deep file access for the rescue module." Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="28,5,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <!-- Opsi 2: Real-time System Monitor -->
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="16" Padding="25" Margin="0,0,0,15">
                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="True">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource EthericMint}" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="18"/>
                                    <TextBlock Text="Real-time System Monitor" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="Enable live CPU and RAM hardware monitoring on the Dashboard." Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="28,5,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </Border>
                    
                    <TextBlock Text="APPLICATION BEHAVIOR" Foreground="{DynamicResource TextSecondary}" FontSize="12" FontWeight="Bold" Margin="0,20,0,15"/>

                    <!-- Opsi 3: System Tray -->
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="16" Padding="25" Margin="0,0,0,15">
                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="True">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource EthericMint}" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="18"/>
                                    <TextBlock Text="Minimize to System Tray on Close" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="Keep KuFi running in the background when the main window is closed." Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="28,5,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <!-- Opsi 4: Dark Mode -->
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="16" Padding="25" Margin="0,0,0,30">
                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" IsEnabled="False">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource EthericMint}" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="18"/>
                                    <TextBlock Text="Dark Mode (Default)" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="Etheric Mint dark theme is permanently enabled to save energy and eye strain." Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="28,5,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </Border>
                </StackPanel>
                
                <!-- Tombol Simpan ditaruh di luar StackPanel Left-Aligned agar bisa ke tengah layar -->
                <StackPanel Margin="0,15,0,30">
                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center">
                        <Border Background="{DynamicResource EthericMint}" CornerRadius="8" Width="200" Height="45">
                            <TextBlock Text="Save Changes" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="#0B1120"/>
                        </Border>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
