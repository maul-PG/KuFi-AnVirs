<Window x:Class="KuFi.UI.Views.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KuFi Notification" Height="100" Width="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" Loaded="Window_Loaded">
    
    <Window.Resources>
        <!-- Referensi ke Colors.xaml -->
        <ResourceDictionary Source="../Styles/Colors.xaml"/>
    </Window.Resources>

    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource EthericMint}" BorderThickness="1" CornerRadius="8">
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Icon K -->
            <Path Grid.RowSpan="2" Grid.Column="0" Data="M 0 0 L 4 0 L 4 10 L 12 0 L 17 0 L 7 12 L 17 24 L 12 24 L 4 14 L 4 24 L 0 24 Z" 
                  Fill="{DynamicResource EthericMint}" Stretch="Uniform" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,10,0"/>

            <!-- Judul -->
            <TextBlock Grid.Row="0" Grid.Column="1" Text="Ancaman Terdeteksi!" Foreground="{DynamicResource ErrorRed}" FontWeight="Bold" FontSize="14"/>
            
            <!-- Nama File -->
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtFileName" Text="filename.exe" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>

            <!-- Tombol Aksi -->
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="BtnAbaikan" Content="Abaikan" Background="Transparent" Foreground="{DynamicResource TextSecondary}" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" Click="BtnAbaikan_Click"/>
                <Button x:Name="BtnHapus" Content="Hapus" Background="{DynamicResource ErrorRed}" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="10,2" Click="BtnHapus_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
