<Window x:Class="KuFi.UI.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About KuFi" Height="300" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">
    
    <Border Background="#1E293B" CornerRadius="12" BorderBrush="#2A374A" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Grid Grid.Row="0" Background="#0F172A" Margin="0,0,0,0">
                <Grid.Clip>
                    <RectangleGeometry Rect="0,0,380,40" RadiusX="12" RadiusY="12"/>
                </Grid.Clip>
                <TextBlock Text="About KuFi AnVirs" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="15,10"/>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Width="30" Height="30" Background="Transparent" BorderThickness="0" Foreground="White" Cursor="Hand" Click="Close_Click">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="15">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#44EF4444"/>
                                    <Setter Property="Foreground" Value="#EF4444"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
            <Rectangle Grid.Row="0" Height="1" Fill="#2A374A" VerticalAlignment="Bottom"/>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="KuFi AnVirs" Foreground="#99F6E4" FontSize="28" FontWeight="Black" HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                <TextBlock Text="Version 1.0.0" Foreground="#94A3B8" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,20"/>
                
                <TextBlock Text="Securing your digital environment." Foreground="#CBD5E1" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                
                <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Github_Click" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <!-- GitHub Icon (generic web icon since MDL2 lacks exact GitHub) -->
                        <TextBlock Text="&#xE12B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#99F6E4" VerticalAlignment="Center"/>
                        <TextBlock Text="maul-PG" Foreground="#99F6E4" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BgBorder" Background="#0F172A" CornerRadius="8" Padding="15,10" BorderBrush="#2A374A" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BgBorder" Property="Background" Value="#1A99F6E4"/>
                                    <Setter TargetName="BgBorder" Property="BorderBrush" Value="#99F6E4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
