<Page x:Class="KuFi.UI.Views.SandboxPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="SandboxPage"
      Background="{DynamicResource BgDeepDarkBlue}"
      AllowDrop="True" Drop="Page_Drop">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="60,30,60,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="TOOLS   >   " Foreground="{DynamicResource TextSecondary}" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock Text="SANDBOX" Foreground="{DynamicResource EthericMint}" FontSize="12" FontWeight="Bold"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Sandbox Manager" Foreground="{DynamicResource TextPrimary}" FontSize="32" FontWeight="SemiBold"/>
                <TextBlock Text="Protection Status: Engine Active" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Bottom" Margin="40,0,0,5" FontStyle="Italic"/>
            </StackPanel>
        </StackPanel>

        <!-- Area Drag & Drop + Live Monitoring -->
        <Grid Grid.Row="1" Margin="0,0,0,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="3.5*"/>
            </Grid.ColumnDefinitions>

            <!-- Box Drag & Drop Kiri -->
            <!-- Diberikan styling dash untuk menandakan area drop file -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackground}" CornerRadius="16" BorderBrush="#1E293B" BorderThickness="2" Padding="50" AllowDrop="True" Drop="DropArea_Drop" DragOver="DropArea_DragOver" MouseLeftButtonDown="DropArea_Click" Cursor="Hand">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#132A33" Width="60" Height="60" CornerRadius="30" Margin="0,0,0,20" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource EthericMint}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Add App to Sandbox" Foreground="{DynamicResource TextPrimary}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Drag and drop executable files here or browse your system&#x0a;to launch them in an isolated session." Foreground="{DynamicResource TextSecondary}" FontSize="14" TextAlignment="Center" Margin="0,0,0,30" LineHeight="22"/>
                    <Button Click="BtnBrowse_Click" Background="{DynamicResource EthericMint}" Foreground="#0F172A" FontWeight="Bold" FontSize="14" Padding="30,12" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                        Browse Files
                    </Button>
                </StackPanel>
            </Border>

            <!-- Box Live Monitoring Kanan -->
            <Border Grid.Column="2" Background="{DynamicResource CardBackground}" CornerRadius="16" Padding="35">
                <StackPanel>
                    <!-- Header Monitoring -->
                    <Grid Margin="0,0,0,40">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource EthericMint}" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Live Monitoring" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Background="#2A374A" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right">
                            <TextBlock Text="LIVE" Foreground="{DynamicResource EthericMint}" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </Grid>

                    <!-- Bar RAM -->
                    <TextBlock Text="Sandbox RAM usage" Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,35">
                        <ProgressBar x:Name="ProgRam" Value="0" Maximum="2048" Height="10" Background="#1E293B" Foreground="{DynamicResource EthericMint}" BorderThickness="0"/>
                        <TextBlock x:Name="TxtRamVal" Text="0 MB" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Right" Margin="0,-30,0,0"/>
                    </Grid>

                    <!-- Bar CPU -->
                    <TextBlock Text="Sandbox CPU usage" Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,45">
                        <ProgressBar x:Name="ProgCpu" Value="0" Maximum="100" Height="10" Background="#1E293B" Foreground="{DynamicResource EthericMint}" BorderThickness="0"/>
                        <TextBlock x:Name="TxtCpuVal" Text="0.0 %" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Right" Margin="0,-30,0,0"/>
                    </Grid>

                    <!-- Indikator Instance -->
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource EthericMint}" Margin="0,0,10,0"/>
                        <TextBlock Text="ACTIVE INSTANCES: " Foreground="{DynamicResource TextSecondary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtInstances" Text="00" Foreground="{DynamicResource TextSecondary}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Daftar Aplikasi Sandbox Aktif -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackground}" CornerRadius="16" Padding="30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,25">
                    <TextBlock Text="Active Sandbox List" Foreground="{DynamicResource TextPrimary}" FontSize="22" FontWeight="SemiBold"/>
                    <Button Click="BtnRefresh_Click" Background="Transparent" BorderThickness="0" Margin="15,0,0,0" Cursor="Hand" ToolTip="Refresh Status">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextSecondary}" FontSize="18" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <!-- Header Kolom -->
                <Grid Grid.Row="1" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="Auto" MinWidth="130"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="APPLICATION" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="LAUNCH TIME" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Grid.Column="2" Text="NETWORK ACCESS" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Grid.Column="3" Text="STATUS" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Grid.Column="4" Text="ACTIONS" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                </Grid>

                <Rectangle Grid.Row="1" Height="1" Fill="#2A374A" VerticalAlignment="Bottom" Margin="0,0,0,-8"/>

                <!-- ListView dinamis -->
                <ListView x:Name="AppsList" Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="0,20,0,0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="Auto" MinWidth="130"/>
                                </Grid.ColumnDefinitions>

                                <!-- Aplikasi -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Border Background="#1E293B" Width="36" Height="36" CornerRadius="8" Margin="0,0,15,0">
                                        <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextSecondary}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Waktu -->
                                <TextBlock Grid.Column="1" Text="{Binding TimeStr}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="14"/>

                                <!-- Jaringan -->
                                <Border Grid.Column="2" Background="#3D1E1E" CornerRadius="4" Padding="10,5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="BLOCKED" Foreground="#F87171" FontSize="10" FontWeight="Bold"/>
                                </Border>

                                <!-- Status Running -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource EthericMint}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Running" Foreground="{DynamicResource TextPrimary}" FontSize="14"/>
                                </StackPanel>

                                <!-- Aksi Stop -->
                                <Button Grid.Column="4" Content="STOP SANDBOX" Foreground="#F87171" Background="Transparent" BorderBrush="#F87171" BorderThickness="1" FontSize="11" FontWeight="Bold" Padding="15,8" Cursor="Hand" Click="StopApp_Click" Tag="{Binding ProcessId}">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    
                    <!-- Kustomisasi List Item UI -->
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
