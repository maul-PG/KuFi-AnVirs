<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Mendeklarasikan bahwa aplikasi butuh UAC elevation via app.manifest -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <AssemblyName>KuFi AnVirs</AssemblyName>
  </PropertyGroup>
  
  <ItemGroup>
    <Resource Include="Assets\logo.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\KuFi.Engine\KuFi.Engine.csproj" />
    <ProjectReference Include="..\KuFi.Data\KuFi.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="taskkill /F /IM KuFi.Watchdog.exe /T 2&gt;nul || exit 0" IgnoreExitCode="true" />
  </Target>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="xcopy /Y /S &quot;$(MSBuildThisFileDirectory)..\KuFi.Watchdog\bin\$(Configuration)\net8.0\*.*&quot; &quot;$(TargetDir)&quot;" />
  </Target>
</Project>
