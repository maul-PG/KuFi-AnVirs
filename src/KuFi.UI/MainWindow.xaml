<Window x:Class="KuFi.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KuFi.UI.ViewModels"
        Title="KuFi AnVirs" Height="768" Width="1366"
        Background="{DynamicResource BgDeepDarkBlue}"
        WindowStartupLocation="CenterScreen">
        
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="1" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ContextMenu WPF untuk System Tray (Rounded & Minimalist) -->
            <ContextMenu x:Key="TrayMenu" Background="#0F172A" Foreground="White" BorderThickness="0" HasDropShadow="True" Placement="MousePoint">
                <ContextMenu.Resources>
                    <Style TargetType="ContextMenu">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ContextMenu">
                                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="5">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="15" Opacity="0.5" ShadowDepth="5"/>
                                        </Border.Effect>
                                        <ItemsPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="20,10"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontFamily" Value="Segoe UI"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="MenuItem">
                                    <Border x:Name="BgBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <!-- Gelap dengan Opacity diturunkan -->
                                            <Setter TargetName="BgBorder" Property="Background" Value="#1A99F6E4"/>
                                            <Setter Property="Foreground" Value="{DynamicResource EthericMint}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ContextMenu.Resources>
                
                <MenuItem Header="Scan Now" Click="TrayScan_Click"/>
                <MenuItem Header="Settings" Click="TraySettings_Click"/>
                <MenuItem Header="About" Click="TrayAbout_Click"/>
                <Separator Background="#1E293B" Margin="5"/>
                <MenuItem Header="Exit" Click="TrayExit_Click"/>
            </ContextMenu>
            
            <!-- Style Minimalis untuk Tombol Navigasi Sidebar -->
            <Style x:Key="SidebarButtonStyle" TargetType="RadioButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Margin" Value="0,10"/>
                <Setter Property="Height" Value="55"/>
                <Setter Property="Cursor" Value="Hand"/>
                <!-- Mengganti tampilan radio button default menjadi block button -->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                        <!-- Indikator garis kiri menggunakan BorderThickness 3,0,0,0 -->
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="3,0,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Efek Hover (Mint tipis / Opacity ~10% = #1A...) -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1A99F6E4"/>
                                <Setter Property="Foreground" Value="{DynamicResource EthericMint}"/>
                            </Trigger>
                            <!-- Efek Terpilih (Active) -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource EthericMint}"/>
                                <Setter TargetName="Border" Property="Background" Value="#1A99F6E4"/>
                                <Setter Property="Foreground" Value="{DynamicResource EthericMint}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar Width -->
            <ColumnDefinition Width="85"/>
            <!-- Frame Width -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar (Kiri) -->
        <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
            <Grid>
                <StackPanel Margin="0,40,0,0" VerticalAlignment="Top">
                    <!-- Teks Logo KuFi -->
                    <TextBlock Text="KuFi" Foreground="{DynamicResource EthericMint}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,50"/>
                    <!-- Tombol Dashboard -->
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource SidebarButtonStyle}" IsChecked="True" Command="{Binding NavigateDashboardCommand}" GroupName="NavGroup">
                        <TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="22"/>
                    </RadioButton>
                    
                    <!-- Tombol Perlindungan / Sandbox -->
                    <RadioButton x:Name="NavSandbox" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateSandboxCommand}" GroupName="NavGroup">
                        <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="22"/>
                    </RadioButton>
                    
                    <!-- Tombol Rescue -->
                    <RadioButton x:Name="NavRescue" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateRescueCommand}" GroupName="NavGroup">
                        <TextBlock Text="&#xE8D5;" FontFamily="Segoe MDL2 Assets" FontSize="22"/>
                    </RadioButton>
                    
                    <!-- Tombol Logs -->
                    <RadioButton x:Name="NavLogs" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateLogsCommand}" GroupName="NavGroup">
                        <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="22"/>
                    </RadioButton>
                </StackPanel>
                
                <!-- Tombol Settings -->
                <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,40">
                    <RadioButton x:Name="NavSettings" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateSettingsCommand}" GroupName="NavGroup">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="22"/>
                    </RadioButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Area Konten Dinamis (Kanan) -->
        <!-- NavigationUIVisibility="Hidden" akan menyembunyikan panah 'Back/Forward' default milik Frame -->
        <Frame x:Name="MainFrame" Grid.Column="1" 
               Source="{Binding CurrentPage}" 
               NavigationUIVisibility="Hidden" 
               Background="Transparent"
               BorderThickness="0"/>
    </Grid>
</Window>
